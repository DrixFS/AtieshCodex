# Atiesh Codex - Environment Variables Template
# Copy this file to .env or .env.local for local overrides.

# Server Configuration
PORT=3001
NODE_ENV=development
GLOBAL_PREFIX=api
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,https://atieshcodex.com,https://app.atieshcodex.com"

# Swagger / OpenAPI
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE="Atiesh Codex API"
SWAGGER_DESCRIPTION="REST and WebSocket API specification for Atiesh Codex services"
SWAGGER_VERSION=1.0.0

# Secrets & Security (Keep secret in production; set via K8s Secret or Vault)
APP_SECRET=local-development-secret-key-change-in-production
DATABASE_URL=
REDIS_PASSWORD=

# Redis & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=atiesh_codex:
REDIS_TLS=false
QUEUE_PREFIX=atiesh_codex_queue
QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_DELAY=1000

# Client Configuration
VITE_API_BASE_URL=http://localhost:3001/api
