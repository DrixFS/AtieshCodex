{
  "name": "@atiesh/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atiesh Codex - Auto-generated API Contracts and Schemas",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./dist": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('tsconfig.tsbuildinfo', { force: true })\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@atiesh/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
