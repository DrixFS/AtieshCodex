{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "Atiesh Codex - NestJS Server API",
  "scripts": {
    "dev": "nest start --watch",
    "dev:debug": "nest start --debug --watch",
    "generate:api-types": "ts-node --transpile-only scripts/generate-api-types.ts",
    "build": "nest build",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "start": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "check:circular": "dpdm --exit-code circular:1 --warning=false --tree=false \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "typewatch": "tsc --noEmit --watch"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "@swc/jest",
        {
          "jsc": {
            "target": "es2022",
            "parser": {
              "syntax": "typescript",
              "decorators": true,
              "dynamicImport": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            },
            "keepClassNames": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.2.3",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "bullmq": "^5.41.6",
    "compression": "^1.8.2",
    "ioredis": "^5.6.0",
    "nestjs-pino": "^5.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@atiesh/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.3",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/pino-http": "^6.1.0",
    "@types/supertest": "^7.2.1",
    "jest": "catalog:",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.1.3",
    "prettier": "catalog:",
    "supertest": "^7.2.2",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  }
}
